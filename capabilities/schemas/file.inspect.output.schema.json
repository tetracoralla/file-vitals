{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:capability:file.inspect:v0.1:output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "file",
    "identity",
    "traits",
    "integrity",
    "diagnostics",
    "provenance",
    "limits"
  ],
  "properties": {
    "status": { "enum": ["ok", "partial", "unsupported", "corrupt"] },
    "file": { "$ref": "#/$defs/file" },
    "identity": { "$ref": "#/$defs/identity" },
    "traits": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 64 }
    },
    "integrity": { "$ref": "#/$defs/integrity" },
    "structured": { "$ref": "#/$defs/structured" },
    "image": { "$ref": "#/$defs/image" },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "provenance": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/provenance" }
    },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "extension"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "extension": { "type": "string", "maxLength": 64 },
        "modified_utc": { "type": "string", "format": "date-time" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "media_type", "confidence"],
      "properties": {
        "source": { "type": "string", "maxLength": 64 },
        "media_type": { "type": "string", "maxLength": 128 },
        "format": { "type": "string", "maxLength": 128 },
        "confidence": { "enum": ["exact", "high", "probable", "unknown"] }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type", "format", "confidence", "candidates", "conflicts"],
      "properties": {
        "kind": {
          "enum": [
            "text", "data", "image", "media", "audio", "video", "document",
            "archive", "font", "binary", "unknown"
          ]
        },
        "media_type": { "type": "string", "maxLength": 128 },
        "format": { "type": "string", "maxLength": 128 },
        "format_version": { "type": "string", "maxLength": 64 },
        "confidence": { "enum": ["exact", "high", "probable", "unknown"] },
        "extension_match": { "type": "boolean" },
        "candidates": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/candidate" } },
        "conflicts": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 256 } }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readable"],
      "properties": {
        "readable": { "type": "boolean" },
        "parseable": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "structured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "toml", "xml", "svg"] },
        "parseable": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "bit_depth": { "type": "integer", "minimum": 0 },
        "color_model": { "type": "string", "maxLength": 64 },
        "has_alpha": { "type": "boolean" },
        "frame_count": { "type": "integer", "minimum": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "maxLength": 512 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "status"],
      "properties": {
        "probe": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 128 },
        "status": { "enum": ["used", "unavailable", "failed", "skipped"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "response_bytes_max", "timeout_ms", "memory_bytes_max"],
      "properties": {
        "mode": { "enum": ["quick", "standard", "deep"] },
        "response_bytes_max": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "memory_bytes_max": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
