{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://file-vitals.local/schema/inspection-result-1.1.json",
  "title": "File Vitals result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "file", "identity", "traits", "constraints", "integrity", "diagnostics", "provenance", "limits"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "status": {"enum": ["ok", "partial", "unsupported", "corrupt", "error"]},
    "file": {"$ref": "#/$defs/file"},
    "identity": {"$ref": "#/$defs/identity"},
    "traits": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}},
    "constraints": {"type": "array", "maxItems": 16, "items": {"enum": ["active_content", "archive_devices", "archive_links", "archive_unsafe_paths", "embedded_objects", "encrypted", "external_references", "indirect_content", "integrity_mismatch"]}},
    "integrity": {"$ref": "#/$defs/integrity"},
    "text": {"$ref": "#/$defs/text"},
    "structured": {"$ref": "#/$defs/structured"},
    "image": {"$ref": "#/$defs/image"},
    "media": {"$ref": "#/$defs/media"},
    "video_streams": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/video"}},
    "audio_streams": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/audio"}},
    "archive": {"$ref": "#/$defs/archive"},
    "pdf": {"$ref": "#/$defs/pdf"},
    "ooxml": {"$ref": "#/$defs/ooxml"},
    "svg": {"$ref": "#/$defs/svg"},
    "indirection": {"$ref": "#/$defs/indirection"},
    "font": {"$ref": "#/$defs/font"},
    "binary": {"$ref": "#/$defs/binary"},
    "diagnostics": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/diagnostic"}},
    "provenance": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}},
    "limits": {"$ref": "#/$defs/limits"},
    "error": {"$ref": "#/$defs/error"}
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size_bytes", "extension"],
      "properties": {
        "name": {"type": "string", "maxLength": 256},
        "size_bytes": {"type": "integer", "minimum": 0},
        "extension": {"type": "string", "maxLength": 64},
        "modified_utc": {"type": "string", "format": "date-time"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "media_type", "confidence"],
      "properties": {
        "source": {"type": "string", "maxLength": 64},
        "media_type": {"type": "string", "maxLength": 128},
        "format": {"type": "string", "maxLength": 128},
        "confidence": {"enum": ["exact", "high", "probable", "unknown"]}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "media_type", "format", "confidence", "candidates", "conflicts"],
      "properties": {
        "kind": {"enum": ["text", "data", "image", "media", "audio", "video", "document", "archive", "font", "binary", "unknown"]},
        "media_type": {"type": "string", "maxLength": 128},
        "format": {"type": "string", "maxLength": 128},
        "format_version": {"type": "string", "maxLength": 64},
        "confidence": {"enum": ["exact", "high", "probable", "unknown"]},
        "extension_match": {"type": "boolean"},
        "candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/candidate"}},
        "conflicts": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 256}}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["readable"],
      "properties": {
        "readable": {"type": "boolean"},
        "parseable": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sha256_matches": {"type": "boolean"}
      }
    },
    "certainty": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "certainty", "evidence"],
      "properties": {
        "value": {"type": "string", "maxLength": 64},
        "certainty": {"enum": ["exact", "probable", "unknown"]},
        "evidence": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "sampled", "sample_bytes"],
      "properties": {
        "encoding": {"$ref": "#/$defs/certainty"},
        "bom": {"type": "string", "maxLength": 32},
        "line_count": {"type": "integer", "minimum": 0},
        "line_ending": {"enum": ["lf", "crlf", "cr", "mixed", "none"]},
        "final_newline": {"type": "boolean"},
        "sampled": {"type": "boolean"},
        "sample_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "structured": {
      "type": "object", "additionalProperties": false,
      "required": ["format"],
      "properties": {"format": {"enum": ["json", "jsonl", "csv", "tsv", "yaml", "toml", "xml", "svg"]}, "parseable": {"type": "boolean", "description": "Omitted when bounded validation did not reach a conclusion."}}
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0},
        "bit_depth": {"type": "integer", "minimum": 0}, "color_model": {"type": "string", "maxLength": 64},
        "has_alpha": {"type": "boolean"}, "frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "rational": {
      "type": "object", "additionalProperties": false, "required": ["num", "den"],
      "properties": {"num": {"type": "integer"}, "den": {"type": "integer", "not": {"const": 0}}}
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "properties": {"duration_ms": {"type": "integer", "minimum": 0}, "bitrate_bps": {"type": "integer", "minimum": 0}, "container": {"type": "string", "maxLength": 128}}
    },
    "video": {
      "type": "object", "additionalProperties": false, "required": ["index", "codec"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "codec": {"type": "string", "maxLength": 64}, "profile": {"type": "string", "maxLength": 64}, "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0}, "fps": {"$ref": "#/$defs/rational"}, "bitrate_bps": {"type": "integer", "minimum": 0}, "pixel_format": {"type": "string", "maxLength": 64}}
    },
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["index", "codec"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "codec": {"type": "string", "maxLength": 64}, "sample_rate_hz": {"type": "integer", "minimum": 0}, "channels": {"type": "integer", "minimum": 0}, "channel_layout": {"type": "string", "maxLength": 64}, "bitrate_bps": {"type": "integer", "minimum": 0}}
    },
    "archiveEntry": {
      "type": "object", "additionalProperties": false, "required": ["name", "size_bytes", "directory", "encrypted", "kind"],
      "properties": {"name": {"type": "string", "maxLength": 256}, "size_bytes": {"type": "integer", "minimum": 0}, "compressed_bytes": {"type": "integer", "minimum": 0}, "directory": {"type": "boolean"}, "encrypted": {"type": "boolean"}, "kind": {"enum": ["file", "directory", "symlink", "hardlink", "character_device", "block_device", "fifo", "other"]}}
    },
    "archivePathFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["absolute_paths", "parent_paths", "link_entries", "device_entries", "inspection_complete"],
      "properties": {"absolute_paths": {"type": "integer", "minimum": 0}, "parent_paths": {"type": "integer", "minimum": 0}, "link_entries": {"type": "integer", "minimum": 0}, "device_entries": {"type": "integer", "minimum": 0}, "inspection_complete": {"type": "boolean"}}
    },
    "archive": {
      "type": "object", "additionalProperties": false, "required": ["format", "entries_scanned", "uncompressed_bytes_scanned", "encrypted", "path_facts", "entries_truncated", "scan_truncated"],
      "properties": {"format": {"type": "string", "maxLength": 64}, "entry_count": {"type": "integer", "minimum": 0}, "entries_scanned": {"type": "integer", "minimum": 0}, "total_uncompressed_bytes": {"type": "integer", "minimum": 0}, "uncompressed_bytes_scanned": {"type": "integer", "minimum": 0}, "encrypted": {"type": "boolean"}, "path_facts": {"$ref": "#/$defs/archivePathFacts"}, "entries": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/archiveEntry"}}, "entries_truncated": {"type": "boolean"}, "scan_truncated": {"type": "boolean"}}
    },
    "pdf": {
      "type": "object", "additionalProperties": false,
      "required": ["text_layer", "text_pages_sampled", "text_layer_complete"],
      "properties": {"version": {"type": "string", "maxLength": 32}, "page_count": {"type": "integer", "minimum": 0}, "encrypted": {"type": "boolean"}, "title": {"type": "string", "maxLength": 256}, "author": {"type": "string", "maxLength": 256}, "text_layer": {"enum": ["present", "absent", "unknown"]}, "text_pages_sampled": {"type": "integer", "minimum": 0, "maximum": 5}, "text_layer_complete": {"type": "boolean"}}
    },
    "ooxml": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "macro_enabled", "external_relationships", "embedded_objects", "inspection_complete"],
      "properties": {"kind": {"enum": ["docx", "docm", "xlsx", "xlsm", "pptx", "pptm"]}, "sheet_count": {"type": "integer", "minimum": 0}, "slide_count": {"type": "integer", "minimum": 0}, "macro_enabled": {"type": "boolean"}, "external_relationships": {"type": "integer", "minimum": 0}, "embedded_objects": {"type": "integer", "minimum": 0}, "inspection_complete": {"type": "boolean"}}
    },
    "svg": {
      "type": "object", "additionalProperties": false,
      "required": ["script_count", "external_href_count", "inspection_complete"],
      "properties": {"script_count": {"type": "integer", "minimum": 0}, "external_href_count": {"type": "integer", "minimum": 0}, "inspection_complete": {"type": "boolean"}}
    },
    "indirection": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "oid", "declared_size"],
      "properties": {"kind": {"const": "git_lfs_pointer"}, "oid": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "declared_size": {"type": "integer", "minimum": 0}}
    },
    "fontAxis": {
      "type": "object", "additionalProperties": false, "required": ["tag", "minimum", "default", "maximum"],
      "properties": {"tag": {"type": "string", "maxLength": 4}, "minimum": {"type": "number"}, "default": {"type": "number"}, "maximum": {"type": "number"}}
    },
    "font": {
      "type": "object", "additionalProperties": false, "required": ["format", "variable"],
      "properties": {"format": {"type": "string", "maxLength": 64}, "family": {"type": "string", "maxLength": 256}, "subfamily": {"type": "string", "maxLength": 128}, "weight": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "OpenType/CSS font-weight scale."}, "variable": {"type": "boolean"}, "glyph_count": {"type": "integer", "minimum": 0}, "axes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/fontAxis"}}}
    },
    "binary": {
      "type": "object", "additionalProperties": false, "required": ["format"],
      "properties": {"format": {"type": "string", "maxLength": 64}, "architectures": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 64}}, "bits": {"type": "integer", "enum": [32, 64]}, "endianness": {"enum": ["little", "big"]}}
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["code", "severity", "message"],
      "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}, "severity": {"enum": ["info", "warning", "error"]}, "message": {"type": "string", "maxLength": 512}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["probe", "status"],
      "properties": {"probe": {"type": "string", "maxLength": 64}, "version": {"type": "string", "maxLength": 128}, "status": {"enum": ["used", "unavailable", "failed", "skipped"]}}
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["mode", "response_bytes_max", "timeout_ms", "memory_bytes_max"],
      "properties": {"mode": {"enum": ["quick", "standard", "deep"]}, "response_bytes_max": {"type": "integer", "minimum": 1}, "timeout_ms": {"type": "integer", "minimum": 1}, "memory_bytes_max": {"type": "integer", "minimum": 1}, "truncated": {"type": "boolean"}}
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"type": "string", "pattern": "^E_[A-Z0-9_]+$", "maxLength": 64}, "message": {"type": "string", "maxLength": 512}}
    }
  }
}
